{
  "name": "grml-launcher",
  "version": "2.0.0",
  "exports": "./main.ts",
  "tasks": {
    "dev": "deno desktop --hmr -A main.ts",
    "check": "deno check main.ts",
    "build": "deno desktop -A --include ui -o ../build/release/bin/GloriousRepublicModLoader main.ts"
  },
  "compilerOptions": {
    "strict": true
  }
}
